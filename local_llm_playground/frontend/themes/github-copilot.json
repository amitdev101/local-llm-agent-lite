{
  "id": "github-copilot",
  "displayName": "GitHub Copilot",
  "branding": {
    "appName": "Local LLM Playground",
    "logoLight": "/assets/themes/assets/copilot-light.svg",
    "logoDark": "/assets/themes/assets/copilot-dark.svg"
  },
  "layout": { "modelPicker": "composer", "emptyComposer": "center", "settings": "drawer" },
  "text": {
    "welcomeTitle": "What can I help you build?",
    "welcomeSubtitle": "Ask a question or describe what you'd like to create.",
    "promptPlaceholder": "Ask {appName}",
    "newChat": "New conversation", "recentChats": "Conversations", "searchChats": "Search conversations",
    "regenerate": "Retry", "settingsTitle": "Chat settings", "chatLabel": "Chat"
  },
  "icons": { "newChat": "plus", "send": "send" },
  "vars": {
    "--sidebar-width": "292px", "--chat-max-width": "820px",
    "--composer-radius": "12px", "--button-radius": "6px", "--send-radius": "6px",
    "--font-sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "--font-conversation": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "--text-size": "14px", "--line-height": "1.65", "--shadow": "0 2px 8px #00000008"
  },
  "modes": {
    "light": {
      "--bg": "#ffffff", "--panel": "#f6f8fa", "--panel-2": "#ffffff", "--panel-3": "#eaeef2",
      "--text": "#1f2328", "--muted": "#59636e", "--line": "#d1d9e0", "--accent": "#1f883d", "--on-accent": "#ffffff",
      "--danger": "#cf222e", "--warning": "#8a5d00", "--success": "#1a7f37", "--focus": "#0969da", "--code-bg": "#f6f8fa", "--overlay": "#1f232855"
    },
    "dark": {
      "--bg": "#0d1117", "--panel": "#010409", "--panel-2": "#161b22", "--panel-3": "#21262d",
      "--text": "#e6edf3", "--muted": "#919ca8", "--line": "#30363d", "--accent": "#238636", "--on-accent": "#ffffff",
      "--danger": "#ff8e94", "--warning": "#d9ad55", "--success": "#56d364", "--focus": "#58a6ff", "--code-bg": "#161b22", "--overlay": "#000000aa"
    }
  }
}
